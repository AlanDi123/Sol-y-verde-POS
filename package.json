    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.6",
    "escpos-buffer": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "uuid": "^9.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.57.1",
